<UserControl x:Class="TrinityCreator.Shared.Tools.ProfileCreator.ProfileCreatorEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrinityCreator.Shared.Tools.ProfileCreator"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="490">
    <WrapPanel Orientation="Horizontal">
        <TextBox Text="{Binding AppKey}" Name="appKeyTb" IsReadOnly="True" Width="135" Margin="5" ToolTip="Ключ приложения"/>
        <TextBox Text="{Binding SqlKey}" IsEnabled="{Binding IsIncluded}" Width="135" Margin="5" ToolTip="SqlKey — соответствующее имя столбца в базе данных эмулятора."/>
        <TextBox Text="{Binding TableName}" IsEnabled="{Binding IsIncluded}" Width="170" Margin="5" ToolTip="Имя таблицы. Используйте %t для динамического имени таблицы."/>
        <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" ToolTip="Снимите отметку, чтобы не учитывать этот AppKey при создании SQL-запроса."/>
    </WrapPanel>
</UserControl>
