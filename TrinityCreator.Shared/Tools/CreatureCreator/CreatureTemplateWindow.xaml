<Window x:Class="TrinityCreator.Shared.Tools.CreatureCreator.CreatureTemplateWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TrinityCreator.Shared"
      mc:Ignorable="d"
      ResizeMode="NoResize" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner"
      Width="300" Height="400" Title="Выбор шаблона существа">
    <DockPanel>
        <DockPanel DockPanel.Dock="Left">
            <Button DockPanel.Dock="Bottom" Content="Отмена" Click="cancelBtn_Click" IsDefault="True" Margin="2"/>
            <Button DockPanel.Dock="Bottom" Content="Загрузить выбранный шаблон" Click="loadTemplateBtn_Click" IsDefault="True" Margin="2" FontWeight="Bold"/>
            <ListBox Name="templateListBox" DockPanel.Dock="Top" Margin="2"/>
        </DockPanel>
    </DockPanel>
</Window>
