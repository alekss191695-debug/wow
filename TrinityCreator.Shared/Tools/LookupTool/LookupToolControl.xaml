<UserControl x:Class="TrinityCreator.Shared.Tools.LookupTool.LookupToolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrinityCreator.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" >
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Label Content="Найти"/>
                <ComboBox Name="targetSelectCb" SelectionChanged="targetSelectCb_SelectionChanged">
                    <ComboBoxItem Content="Тип задания" />
                    <ComboBoxItem Content="Карта" />
                    <ComboBoxItem Content="Фракция" />
                    <ComboBoxItem Content="Звание" />
                    <ComboBoxItem Content="Предмет" />
                    <ComboBoxItem Content="Задание" />
                    <ComboBoxItem Content="Существо" />
                    <ComboBoxItem Content="Игровой объект" />
                    <ComboBoxItem Content="Заклинание" />
                    <ComboBoxItem Content="Эмоция" />
                </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,5,0,5">
                <Button Name="searchBtn" Content="Поиск" DockPanel.Dock="Right" Click="searchBtn_Click" IsDefault="True" Width="75"/>
                <TextBox Name="searchTxt" />
            </DockPanel>
            <DataGrid Name="dataGrid" IsReadOnly="True" MouseDoubleClick="dataGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копировать" Click="Context_Copy" />
                        <MenuItem Header="Удалить" Click="Context_Delete" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
