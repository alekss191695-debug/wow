<Window x:Class="TrinityCreator.Shared.Tools.ProfileCreator.ProfileCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrinityCreator.Shared"
        mc:Ignorable="d"
        Title="Создание профиля" Height="600" Width="1100">
    <ScrollViewer>
        <WrapPanel>
            <GroupBox Header="Информация о профиле" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel x:Name="profileInfoSp" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Название профиля"/><TextBox Text="{Binding Name}" Width="325"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Название эмулятора"/><TextBox Text="{Binding EmulatorName}" Width="325"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Версия игры" ToolTip="Например: 3.3.5a или 1.12.2"/><TextBox Text="{Binding GameVersion}" Width="325"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Версия базы данных" ToolTip="Версия базы данных, если она указана, или текущая дата."/><TextBox Text="{Binding DatabaseVersion}" Width="325"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Редакция профиля" ToolTip="Увеличьте номер редакции, чтобы предложить пользователям обновить профиль."/><TextBox Text="{Binding Revision}" Width="325"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5"><Label Width="150" Content="Автор" ToolTip="Имя автора профиля."/><TextBox Text="{Binding Author}" Width="325"/></StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Сведения" Width="500">
                <StackPanel Orientation="Vertical">
                    <StackPanel Margin="5">
                        <TextBlock TextWrapping="Wrap">
                            ВНИМАНИЕ: этот инструмент предназначен для опытных пользователей.<LineBreak/>
                            <Hyperlink NavigateUri="https://github.com/NotCoffee418/TrinityCreator/wiki/Adding-Emulator-Support" RequestNavigate="Hyperlink_RequestNavigate">Прочитать документацию</Hyperlink>
                            <LineBreak/><LineBreak/>
                            Важные замечания:<LineBreak/>
                            Можно загрузить существующий профиль и изменить его.<LineBreak/>
                            Структуры большинства эмуляторов похожи, поэтому большая часть работы будет выполнена за вас.<LineBreak/><LineBreak/>
                            Необязательно заполнять все поля.<LineBreak/>
                            Некоторые параметры противоречат друг другу — это нужно для поддержки разных эмуляторов.<LineBreak/><LineBreak/>
                            Наведите указатель на текстовые поля, чтобы увидеть подсказки. В некоторых подсказках описано, как использовать параметр.
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="loadBtn" Content="Загрузить профиль из файла" Margin="5" Height="25" Width="165" Click="loadBtn_Click"/>
                        <Button Name="copyBtn" Content="Копировать JSON" Margin="5" Height="25" Width="150" Click="copyBtn_Click"/>
                        <Button Name="saveBtn" Content="Сохранить в файл" Margin="5" Height="25" Width="150" Click="saveBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Задание" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="questSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Существо" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="creatureSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Предмет" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="itemSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Добыча" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="lootSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Торговец" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="vendorSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Определения" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"><StackPanel x:Name="definitionsSp" Orientation="Vertical"/></GroupBox>
            <GroupBox Header="Пользовательские поля" Width="500" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical"><StackPanel x:Name="customFieldsSp" Orientation="Vertical"/><Button x:Name="addCustomFieldBtn" Content="Добавить пользовательское поле" Margin="5" Click="addCustomFieldBtn_Click"/></StackPanel>
            </GroupBox>
        </WrapPanel>
    </ScrollViewer>
</Window>
