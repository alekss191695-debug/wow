<UserControl x:Class="TrinityCreator.Shared.Tools.VendorCreator.VendorEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrinityCreator.Shared.Tools.VendorCreator"
             xmlns:conv="clr-namespace:TrinityCreator.Shared.UI.Converters"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="300" Width="300">
    <UserControl.Resources><conv:ValueToVisibilityConverter x:Key="ValueVisibilityConverter"/></UserControl.Resources>
    <GroupBox Header="Предмет торговца" Margin="5">
        <StackPanel>
            <DockPanel Margin="2"><TextBlock Text="ID предмета" Width="100" DockPanel.Dock="Left" Margin="5"/><Button Content="Найти" Width="80" Click="itemLookupBtn_Click" DockPanel.Dock="Right" Margin="2,0,0,0"/><TextBox Name="itemTb"/></DockPanel>
            <GroupBox x:Name="customDisplayFieldGb" Header="Пользовательские поля отображения"/>
            <DockPanel Margin="2"><CheckBox Margin="5" Content="Дополнительные параметры" Name="advancedCb" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/><Button Name="removeMeBtn" Margin="5" Width="24" Height="24" HorizontalAlignment="Right" Click="removeMeBtn_Click"><Image Source="/TrinityCreator.Shared;component/Resources/remove-icon.png"/></Button></DockPanel>
            <StackPanel Visibility="{Binding ElementName=advancedCb, Path=IsChecked, Converter={StaticResource ValueVisibilityConverter}}">
                <DockPanel Margin="2" ToolTip="Положение предмета при открытии окна торговца."><TextBlock Text="Ячейка (позиция)" Width="150" DockPanel.Dock="Left" Margin="5"/><TextBox Name="slotTb" Text="0"/></DockPanel>
                <DockPanel Margin="2" ToolTip="Максимальное количество предметов, которое торговец может иметь одновременно."><TextBlock Text="Максимальное количество" Width="150" DockPanel="Left" Margin="5"/><TextBox Name="maxcountTb" Text="0"/></DockPanel>
                <DockPanel Margin="2" ToolTip="Вместе с максимальным количеством задаёт интервал обновления списка торговца и пополнения ограниченного запаса предметов в секундах."><TextBlock Text="Интервал пополнения (сек.)" Width="150" DockPanel.Dock="Left" Margin="5"/><TextBox Name="incrTimeTb" Text="0"/></DockPanel>
                <DockPanel Margin="2" ToolTip="ID из ItemExtendedCost.dbc определяет не денежную стоимость предмета: очки чести, арены и другие валюты."><TextBlock Text="Дополнительная стоимость (DBC)" Width="180" DockPanel.Dock="Left" Margin="5"/><TextBox Name="extendedCostTb" Text="0"/></DockPanel>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
