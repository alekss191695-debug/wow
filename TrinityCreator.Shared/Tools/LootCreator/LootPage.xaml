<Page x:Class="TrinityCreator.Shared.Tools.LootCreator.LootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
      Title="Создание добычи">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="2">
                <TextBlock Text="Тип добычи" Width="100" DockPanel.Dock="Left" Margin="5"/>
                <ComboBox Name="lootTypeCb" SelectedIndex="0">
                    <ComboBoxItem Content="Существо"/><ComboBoxItem Content="Распыление"/><ComboBoxItem Content="Рыбалка"/>
                    <ComboBoxItem Content="Игровой объект"/><ComboBoxItem Content="Предмет"/><ComboBoxItem Content="Почта"/>
                    <ComboBoxItem Content="Перемалывание"/><ComboBoxItem Content="Карманная кража"/><ComboBoxItem Content="Просеивание"/>
                    <ComboBoxItem Content="Ссылка"/><ComboBoxItem Content="Снятие шкур"/><ComboBoxItem Content="Заклинание"/>
                </ComboBox>
            </DockPanel>
            <DockPanel Margin="2"><TextBlock Text="ID шаблона добычи" Width="120" DockPanel.Dock="Left" Margin="5"/><TextBox Name="entryTb"/></DockPanel>
            <StackPanel Name="lootRowSp"/>
            <Button Margin="5" HorizontalAlignment="Center" Click="addLineBtn_Click">
                <StackPanel Orientation="Horizontal" Height="25"><Image Source="/TrinityCreator.Shared;component/Resources/add-icon.png" Margin="10,0" Width="20px" Height="20px" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Text="Добавить" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/></StackPanel>
            </Button>
            <StackPanel>
                <Button Margin="5,20,5,0" Content="Экспорт в SQL-файл" Click="exportSqlBtn_Click"/>
                <Button Margin="5,5,5,0" Content="Экспорт в базу данных" Click="exportDbBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
