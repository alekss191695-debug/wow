<Page x:Class="TrinityCreator.Shared.Tools.ModelViewer.ModelViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TrinityCreator.Shared"
      xmlns:uie="clr-namespace:TrinityCreator.Shared.UI.UIElements"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="400"
      Title="Просмотр моделей">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <ComboBox Name="inputIdCb" MinWidth="85" Margin="5" SelectedIndex="0" x:FieldModifier="public">
                <ComboBoxItem Content="ID отображения"/>
                <ComboBoxItem Content="ID записи"/>
            </ComboBox>
            <TextBox Name="displayIdTxt" MinWidth="75" Margin="0,5,0,5" x:FieldModifier="public"/>
            <ComboBox Name="displayTypeCb" MinWidth="90" Margin="5" SelectedIndex="0" x:FieldModifier="public">
                <ComboBoxItem Content="Предмет"/>
                <ComboBoxItem Content="Существо"/>
            </ComboBox>
            <Button Content="Загрузить" Click="loadBtn_Click" Width="90" IsDefault="True" Margin="5"/>
        </StackPanel>
        <uie:Browser x:Name="mvBrowser"/>
    </DockPanel>
</Page>
