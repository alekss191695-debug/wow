<Window x:Class="TrinityCreator.Shared.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trinity Creator" Height="800" Width="1050" MinWidth="800" Icon="/TrinityCreator.Shared;component/Resources/tclogo.png"
        xmlns:local="clr-namespace:TrinityCreator.Shared"
        xmlns:lot="clr-namespace:TrinityCreator.Shared.Tools.LookupTool"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Настройки">
                <MenuItem Name="ConfigureProfile" Header="Выбрать _профиль эмулятора" Click="configureProfile_Click" />
                <MenuItem Name="ConfigureDbc" Header="Настроить путь к _DBC" Click="configureDbc_Click" />
                <MenuItem Name="ConfigureMysql" Header="Настроить _MySQL" Click="configureMysql_Click" />
            </MenuItem>
            <MenuItem Header="Дополнительные инструменты">
                <MenuItem Name="ProfileCreator" Header="Создание _профиля" Click="ProfileCreator_Click" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Проверить обновления" Click="CheckForUpdates_Click" />
                <MenuItem Header="Поддержка (Discord)" Click="DiscordBtn_Click" />
                <MenuItem Header="Сообщить об ошибке" Click="ReportBugs_Click" />
                <MenuItem Header="Открыть файлы журнала" Click="ViewLogsDir_Click" />
                <MenuItem Header="О программе" Click="Credits_Click" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock><TextBlock Text="Совет:" DockPanel.Dock="Left"/><TextBlock Name="randomTipTxt" DockPanel.Dock="Left"/></TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="© 2020 NotCoffee418" TextAlignment="Right" />
            </StatusBarItem>
        </StatusBar>
        <Grid Name="ContentGrid" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700*"/><ColumnDefinition Width="10"/><ColumnDefinition MinWidth="25" MaxWidth="1000"/>
            </Grid.ColumnDefinitions>
            <TabControl Name="TabControl" HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="0">
                <TabItem Header="Предмет"><Frame Name="ItemTab"/></TabItem>
                <TabItem Header="Задание" Height="22" VerticalAlignment="Top"><Frame Name="QuestTab"/></TabItem>
                <TabItem Header="Существо"><Frame Name="CreatureCreatorTab"/></TabItem>
                <TabItem Header="Добыча" Name="LootCreatorTabItem" x:FieldModifier="public"><Frame Name="LootCreatorTab"/></TabItem>
                <TabItem Header="Торговец"><Frame Name="VendorCreatorTab"/></TabItem>
                <TabItem Header="Просмотр моделей" Name="ModelViewer" Selector.Selected="modelViewerTab_Selected"><Frame Name="ModelViewerTabFrame"/></TabItem>
            </TabControl>
            <GridSplitter Name="ContentGridSplitter" ResizeDirection="Columns" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="0" Foreground="Red" DragCompleted="ContentGridSplitter_DragCompleted" />
            <Expander Name="LookupToolExpander" ExpandDirection="Left" HorizontalAlignment="Stretch" Grid.Column="2" Grid.Row="0" IsExpanded="False" Expanded="LookupToolExpander_Expanded" Collapsed="LookupToolExpander_Collapsed">
                <Expander.Header>
                    <TextBlock Text="Поиск"><TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform></TextBlock>
                </Expander.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><lot:LookupToolControl x:Name="LookupTool"/></ScrollViewer>
            </Expander>
        </Grid>
    </DockPanel>
</Window>
