<Window x:Class="TrinityCreator.Shared.Tools.ItemCreator.WeaponExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrinityCreator.Shared.Tools.ItemCreator"
        mc:Ignorable="d"
        Title="Экспорт оружия" Height="500" Width="800" Loaded="Window_Loaded">
    <Grid>
        <RichTextBox x:Name="weaponNoticeRtb" Margin="0,0,0,50" VerticalScrollBarVisibility="Visible"/>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,17">
            <CheckBox Name="neverShowAgainCb" Content="Больше не показывать это окно"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Content="Копировать CSV DBC в буфер обмена (ещё не реализовано)" IsEnabled="False" Margin="5" Width="260"/>
            <Button x:Name="justExportBtn" Content="Только экспорт" Margin="5" Width="110" Click="justExportBtn_Click"/>
            <Button x:Name="deleteExportBtn" Content="Удалить и экспортировать" Margin="5" Width="160" Click="deleteExportBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
